# Copy to deploy/.env on the server (chmod 600). NEVER commit deploy/.env. Values below are descriptions, not secrets.

# --- Hostnames ---
# Public API hostname served by Caddy (free first: <vm-ip-with-dashes>.sslip.io; later: api.engiens.in)
API_HOST=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=
# Exact frontend origin(s), comma-separated, no trailing slash (e.g. https://engiens.vercel.app)
CORS_ALLOWED_ORIGIN=
# Frontend URL used for GitHub App redirects (e.g. https://engiens.vercel.app)
FRONTEND_URL=

# --- Database (only reachable inside the compose network) ---
DB_NAME=engiens
DB_USERNAME=engiens
# Generate: openssl rand -base64 32 | tr -d '/+=' | head -c 32
DB_PASSWORD=

# --- Auth ---
# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=120

# --- GitHub ---
# Optional fine-grained token with no scopes: raises the public API rate limit
GITHUB_TOKEN=
# Optional GitHub App (private repositories). The private key goes on ONE line, newlines removed:
#   awk 'NF {printf "%s", $0}' github-app.pem
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# --- AI providers (server-side only; free tiers) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Scenario Lab sandbox ---
SCENARIO_EXECUTION_ENABLED=true
SCENARIO_EXECUTION_MAX_CONCURRENT=2
# Group id of /var/run/docker.sock on the VM: stat -c %g /var/run/docker.sock
DOCKER_GID=

# --- Per-user daily caps on AI-backed actions (0 = off) ---
REVIEWS_PER_DAY=10
LABS_PER_DAY=5

# --- Release (git SHA tag of the backend image, for rollback) ---
ENGIENS_VERSION=latest
