# Copy to deploy/.env on the server and restrict it: chmod 600 .env. NEVER commit deploy/.env (it is git-ignored).
# Values below are descriptions, not secrets. deploy/README.md explains each step.

# --- Hostnames ---
# Public API hostname served by Caddy, which gets its HTTPS certificate from Let's Encrypt automatically.
# Free first: the Elastic IP with dashes + .sslip.io (e.g. 13-233-10-20.sslip.io); later e.g. api.engiens.in.
API_HOST=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=
# Exact frontend origin(s), comma-separated, no trailing slash (e.g. https://engiens.vercel.app)
CORS_ALLOWED_ORIGIN=
# Frontend URL used for GitHub App redirects (e.g. https://engiens.vercel.app)
FRONTEND_URL=

# --- Database (reachable only inside the compose network; never published) ---
DB_NAME=engiens
DB_USERNAME=engiens
# Generate: openssl rand -base64 32 | tr -d '/+=' | head -c 32
DB_PASSWORD=

# --- Auth ---
# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=120

# --- GitHub ---
# Recommended: a token with no scopes raises GitHub's public API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
# Optional GitHub App (private repositories). The private key goes on ONE line, newlines removed:
#   awk 'NF {printf "%s", $0}' github-app.pem
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# --- AI providers (server-side only) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Scenario Lab sandbox (always the Docker provider in this stack) ---
# Group id of the Docker socket on the VM: stat -c %g /var/run/docker.sock
DOCKER_GID=
# Sandbox runs at once across all users (a Java run may use 512 MB). 1 on a 2 GB machine, 2 on 4 GB.
SCENARIO_EXECUTION_MAX_CONCURRENT=2
# Scenarios built in parallel while a lab generates (each an AI call plus sandbox runs).
SCENARIO_BUILD_CONCURRENCY=3

# --- Per-user daily caps on AI-backed actions (0 = off) ---
REVIEWS_PER_DAY=10
LABS_PER_DAY=5

# --- Memory: the backend container limit (the JVM uses 60% of it as heap) ---
BACKEND_MEMORY=1g
# JVM flags; empty keeps the default (-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError).
JAVA_TOOL_OPTIONS=

# --- Release: the git SHA the backend image is tagged with (rollback = previous SHA) ---
ENGIENS_VERSION=latest
