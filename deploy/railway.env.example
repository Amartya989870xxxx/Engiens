# Engiens variables for Railway. Two services need variables: "backend" (most of this file) and "runner" (at the end).
# Backend: service "backend" → Variables → Raw Editor.
# Paste this, then fill the empty values in Railway's UI. NEVER commit real values; this file only has placeholders.
# ${{Postgres.X}} are Railway reference variables: Railway fills them from the PostgreSQL service in the same project
# (use the service's actual name if it isn't "Postgres"). They use Railway's private network, which has no egress cost.

SPRING_PROFILES_ACTIVE=prod

# --- Database (Railway managed PostgreSQL, private network) ---
DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# --- Frontend (the Vercel URL, exact origin, no trailing slash; comma-separate several) ---
CORS_ALLOWED_ORIGIN=
FRONTEND_URL=

# --- Auth: at least 32 bytes. Generate locally with: openssl rand -base64 48 ---
JWT_SECRET=
JWT_TTL_MINUTES=120

# --- GitHub ---
# Recommended: a token with no scopes raises GitHub's public API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
# Optional GitHub App (private repositories). The private key goes on ONE line: awk 'NF {printf "%s", $0}' github-app.pem
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# --- AI providers (server-side only, free tiers) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Scenario Lab code execution: on the "runner" service, over Railway's private network (Railway can't start the
#     Docker containers the local sandbox uses). The token must equal the runner service's RUNNER_TOKEN.
SCENARIO_EXECUTION_ENABLED=true
SCENARIO_EXECUTION_PROVIDER=runner
SCENARIO_RUNNER_URL=http://${{runner.RAILWAY_PRIVATE_DOMAIN}}:8090
SCENARIO_RUNNER_TOKEN=${{runner.RUNNER_TOKEN}}

# --- Per-user daily caps on AI-backed actions (0 = no cap) ---
REVIEWS_PER_DAY=10
LABS_PER_DAY=5

# --- JVM memory: keeps the backend around 340 MiB instead of ~430 MiB (stretches the trial credit) ---
JAVA_TOOL_OPTIONS=-XX:MaxRAM=512m -XX:MaxRAMPercentage=60 -XX:+UseSerialGC -Xss512k -XX:+ExitOnOutOfMemoryError

# =====================================================================================================================
# Runner service ("runner" → Variables → Raw Editor): only these. It has no database, AI or GitHub access.
# RUNNER_TOKEN: a shared secret the backend sends with each run. Generate locally: openssl rand -hex 32
# ---------------------------------------------------------------------------------------------------------------------
# RUNNER_TOKEN=
# PORT=8090
# RUNNER_MAX_CONCURRENT=2
