# HTTPS for the API, with certificates from Let's Encrypt (automatic issue and renewal).
# API_HOST is the public hostname: a free one first (e.g. <vm-ip-with-dashes>.sslip.io), later api.engiens.in.
# Changing it is one variable in deploy/.env plus `docker compose ... up -d caddy`.
{
	email {$ACME_EMAIL}
}

{$API_HOST} {
	encode zstd gzip
	reverse_proxy backend:8080
	# Only the API is served here; the frontend is on Vercel. Actuator stays limited to /actuator/health.
	header -Server
	log {
		output stdout
		format console
	}
}
