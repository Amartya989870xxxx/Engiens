# Copy to .env (never commit .env). Used by docker-compose and the backend.
DB_NAME=engineeringlens
DB_USERNAME=lens
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/engineeringlens

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-32+chars
JWT_TTL_MINUTES=120

CORS_ALLOWED_ORIGIN=http://localhost:5173

# Optional: a GitHub personal access token (no scopes needed) raises the API rate limit.
GITHUB_TOKEN=

# Optional GitHub App for private repositories (README → "GitHub App"). Leave empty for public-only.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Path is relative to backend/. On a host without files, put the PEM contents in GITHUB_APP_PRIVATE_KEY instead.
GITHUB_APP_PRIVATE_KEY_PATH=../secrets/github-app.pem
FRONTEND_URL=http://localhost:5173
